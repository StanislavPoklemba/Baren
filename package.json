{
  "name": "lumiere-andermatt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lumière Andermatt - Fine dining restaurant website in the Swiss Alps",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && node --watch server.js",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"cyan,yellow\" \"npm run dev\" \"npm run dev:backend\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^11.3.8",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^6.0.0"
  }
}
